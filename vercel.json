{
  "version": 2,
  "builds": [
    {
      "src": "Frontend_Study_plan_app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/auth/(.*)", "dest": "api/index.py" },
    { "src": "/plans", "dest": "api/index.py" },
    { "src": "/plans/(.*)", "dest": "api/index.py" },
    { "src": "/sessions", "dest": "api/index.py" },
    { "src": "/sessions/(.*)", "dest": "api/index.py" },
    { "src": "/assets/(.*)", "dest": "/Frontend_Study_plan_app/dist/assets/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/Frontend_Study_plan_app/dist/index.html" }
  ]
}
